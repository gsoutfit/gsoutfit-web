# =============================================================================
# GENTLEMAN SAVAGE - ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Secret Key (Used for HMAC session tokens and auth cookies)
SESSION_SECRET=your_super_secret_64_character_production_key_here_2026

# Admin Security Token / Registration Key (Optional)
ADMIN_REGISTRATION_SECRET=gs_admin_master_access_key

# Node Environment
NODE_ENV=production

# =============================================================================
# SMTP EMAIL CONFIGURATION (Optional - for real verification emails and OTP)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=Gentleman Savage Concierge <concierge@gentlemansavage.com>
